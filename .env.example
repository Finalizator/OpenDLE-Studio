PORT=3000
# Optional Chromium-based executable for exported games' app windows (Chrome/Edge/Brave/Chromium).
# OPENDLE_BROWSER=/path/to/browser
# Optional persistent app profile; defaults to your OS user configuration directory.
# OPENDLE_STUDIO_PROFILE=/path/to/studio-profile
# Set to 1 to run the service without opening a window.
# OPENDLE_NO_BROWSER=1
# Never put provider credentials in browser code or project files.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional persistent token for external MCP clients; otherwise generated on start.
OPENDLE_TOKEN=
