{
  "name": "opendle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "description": "OpenDLE: Studio - a friendly, easy-to-tweak, source-available game engine and visual level editor in plain JavaScript, for any kind of game and tailored to boomer-shooters, with local DeepSeek and MCP tools",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/launch.js",
    "serve": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-concurrency=${TEST_CONCURRENCY:-4} test/*.test.js",
    "test:freedoom": "node scripts/check-freedoom.js",
    "check": "node scripts/check.js",
    "docs": "node scripts/docs.js",
    "gzdoom:fetch": "node tools/gzdoom/fetch.mjs",
    "gzdoom:run": "node tools/gzdoom/run.mjs",
    "gzdoom:diff": "node tools/gzdoom/diff.mjs",
    "gzdoom:measure": "node tools/gzdoom/measure-actors.mjs",
    "gzdoom:animation": "node tools/gzdoom/animation.mjs",
    "automation": "node tools/automation/run.mjs",
    "automation:brushes": "node tools/automation/run.mjs brushes",
    "automation:menus": "node tools/automation/run.mjs menus",
    "automation:skybox": "node tools/automation/run.mjs skybox",
    "automation:water": "node tools/automation/run.mjs water",
    "automation:shaders": "node tools/automation/run.mjs shaders",
    "automation:maps": "node tools/automation/run.mjs maps",
    "automation:game": "node tools/automation/run.mjs game",
    "automation:close": "node tools/automation/run.mjs close"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "electron": "^45.2.1",
    "express": "^5.1.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "procedural-terrains": "^2.1.0",
    "three": "^0.185.1",
    "yauzl": "^3.2.0",
    "zod": "^3.25.0"
  }
}
